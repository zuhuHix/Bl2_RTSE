{
  "url": "http://127.0.0.1:8766/?t=mock",
  "width": 1440,
  "height": 1000,
  "steps": [
    {
      "wait": 1200
    },
    {
      "clickText": "Skill tree"
    },
    {
      "wait": 900
    },
    {
      "shot": "dev/out/skills_1_tree.png"
    },
    {
      "eval": "document.querySelectorAll('.sk.compact')[3].click()"
    },
    {
      "wait": 400
    },
    {
      "shot": "dev/out/skills_2_detail.png"
    },
    {
      "scroll": {
        "selector": "#workspace",
        "top": 700
      }
    },
    {
      "wait": 300
    },
    {
      "shot": "dev/out/skills_3_lower.png"
    },
    {
      "eval": "document.querySelector('.sk-detail .btn.primary') && document.querySelector('.sk-detail input').value"
    },
    {
      "click": ".sk-detail .btn:nth-of-type(2)"
    },
    {
      "wait": 700
    },
    {
      "eval": "document.querySelector('.toast') && document.querySelector('.toast').textContent"
    },
    {
      "clickText": "Reset tree"
    },
    {
      "wait": 300
    },
    {
      "shot": "dev/out/skills_4_confirm.png"
    },
    {
      "clickText": "Cancel"
    },
    {
      "eval": "fetch('/api/skills?class=siren', {headers: {'X-RTSE-Token': 'mock'}}).then(r => r.json()).then(d => d.tree.branches.map(b => b.label).join(','))"
    },
    {
      "wait": 500
    },
    {
      "wait": 700
    },
    {
      "scroll": {
        "selector": "#workspace",
        "top": 0
      }
    },
    {
      "clickText": "Every ammo type"
    },
    {
      "wait": 400
    },
    {
      "clickText": "Skill tree"
    },
    {
      "wait": 800
    },
    {
      "shot": "dev/out/skills_5_siren.png"
    }
  ]
}